---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { TaskForm } from "@/components/tasks/TaskForm";
import { createClient } from "@/lib/supabase";
import type { TaskWithTags } from "@/types";

const { id } = Astro.params;
if (!id) return Astro.redirect("/tasks");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/tasks");

// eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
const { data, error } = await supabase.from("tasks").select("*, task_tags(*)").eq("id", id).single();

if (error || !data) return Astro.redirect("/tasks");

const task = data as TaskWithTags;
---

<Layout title="Edit Task">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <div class="mt-4">
        <a href="/tasks" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          ← Back to tasks
        </a>
      </div>
      <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-6">
        <h1 class="mb-6 text-xl font-bold text-white">Edit Task</h1>
        <TaskForm task={task} client:load />
      </div>
    </div>
  </div>
</Layout>
