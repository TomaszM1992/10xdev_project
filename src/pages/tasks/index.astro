---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import Banner from "@/components/Banner.astro";
import { TaskList } from "@/components/tasks/TaskList";
import { createClient } from "@/lib/supabase";
import type { TaskWithTags } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let tasks: TaskWithTags[] = [];
let serviceUnavailable = false;
if (supabase) {
  const { data } = await supabase
    .from("tasks")
    .select("*, task_tags(*)")
    .order("created_at", { ascending: false })
    .limit(50);

  tasks = (data ?? []) as TaskWithTags[];
} else {
  serviceUnavailable = true;
}
---

<Layout title="My Tasks">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      {
        serviceUnavailable && (
          <Banner variant="error">Service is temporarily unavailable. Check your environment configuration.</Banner>
        )
      }
      <div class="mt-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-white">My Tasks</h1>
        <a
          href="/tasks/new"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-700"
        >
          + New task
        </a>
      </div>
      <div class="mt-6">
        <TaskList initialTasks={tasks} client:load />
      </div>
    </div>
  </div>
</Layout>
