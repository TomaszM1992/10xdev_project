{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git status *)",
            "Bash(git branch *)",
            "Bash(git checkout *)",
            "Bash(git stash *)",
            "Read",
            "Edit",
            "Write"
        ],
        "ask": [
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(git push *)",
            "Bash(git push)"
        ],
        "deny": [
            "Bash(rm -rf *)"
        ]
    },
    "env": {
        "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
        "OTEL_METRICS_EXPORTER": "otlp"
    }
}